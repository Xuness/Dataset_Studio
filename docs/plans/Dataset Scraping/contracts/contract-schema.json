{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:dataset-studio:pixiv-contracts:v1",
  "title": "Pixiv contracts v1 design schemas",
  "description": "Design-time schemas. Not the generated Studio OpenAPI. Validate by selecting a definition.",
  "definitions": {
    "Id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "SourceId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "Encoding": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "format": {
          "type": "string",
          "enum": ["webp", "jpeg", "png"]
        },
        "max_edge": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "animation": {
          "type": "string",
          "enum": ["preserve", "first_frame"]
        },
        "alpha": {
          "type": "string",
          "enum": ["preserve", "flatten", "reject"]
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "lossless": {
          "type": "boolean"
        },
        "method": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "optimize": {
          "type": "boolean"
        },
        "subsampling": {
          "type": "string",
          "enum": ["444", "420"]
        },
        "compress_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "required": ["version", "format", "max_edge", "animation", "alpha"],
      "additionalProperties": false
    },
    "ImagePolicy": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["metadata_only", "original", "webp-2048-q95", "custom"]
        },
        "allow_sample": {
          "const": false
        },
        "existing": {
          "const": "match_profile"
        },
        "encoding": {
          "$ref": "#/definitions/Encoding"
        }
      },
      "required": ["profile", "allow_sample", "existing"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "profile": {
                "const": "custom"
              }
            }
          },
          "then": {
            "required": ["encoding"]
          },
          "else": {
            "not": {
              "required": ["encoding"]
            }
          }
        }
      ]
    },
    "MediaPlan": {
      "type": "object",
      "properties": {
        "image_policy": {
          "$ref": "#/definitions/ImagePolicy"
        },
        "retain_original": {
          "type": "boolean"
        },
        "ugoira": {
          "type": "string",
          "enum": ["archive_with_poster", "metadata_only"]
        },
        "reuse": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["historical_if_same_locator", "revalidate"]
            },
            "max_age_hours": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8760
            }
          },
          "required": ["mode", "max_age_hours"],
          "additionalProperties": false
        }
      },
      "required": ["image_policy", "retain_original", "ugoira", "reuse"],
      "additionalProperties": false
    },
    "Seeds": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["authors", "works"]
        },
        "ids": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceId"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        }
      },
      "required": ["kind", "ids"],
      "additionalProperties": false
    },
    "Discovery": {
      "type": "object",
      "properties": {
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["bookmarks", "following", "recommendations"]
          },
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "recommendation_seeds_per_author": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      },
      "required": [
        "entrypoints",
        "max_depth",
        "recommendation_seeds_per_author"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "max_depth": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "entrypoints": {
                "maxItems": 0
              },
              "recommendation_seeds_per_author": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "entrypoints": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entrypoints": {
                "contains": {
                  "const": "recommendations"
                }
              }
            }
          },
          "then": {
            "properties": {
              "recommendation_seeds_per_author": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "Scope": {
      "type": "object",
      "properties": {
        "work_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["illustration", "manga", "ugoira"]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "ratings": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["all_ages", "r18", "r18g"]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "include_ai": {
          "type": "boolean"
        },
        "include_unknown_markers": {
          "type": "boolean"
        }
      },
      "required": [
        "work_types",
        "ratings",
        "include_ai",
        "include_unknown_markers"
      ],
      "additionalProperties": false
    },
    "RunBudget": {
      "type": "object",
      "properties": {
        "api_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "admitted_authors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "download_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 109951162777600
        },
        "wall_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800
        }
      },
      "required": [
        "api_requests",
        "admitted_authors",
        "download_bytes",
        "wall_seconds"
      ],
      "additionalProperties": false
    },
    "JobDefinition": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "collector": {
          "const": "pixiv_web_v1"
        },
        "library_id": {
          "$ref": "#/definitions/Id"
        },
        "account_id": {
          "$ref": "#/definitions/Id"
        },
        "seeds": {
          "$ref": "#/definitions/Seeds"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "discovery": {
          "$ref": "#/definitions/Discovery"
        },
        "media": {
          "$ref": "#/definitions/MediaPlan"
        },
        "run_budget": {
          "$ref": "#/definitions/RunBudget"
        }
      },
      "required": [
        "version",
        "collector",
        "library_id",
        "account_id",
        "seeds",
        "scope",
        "discovery",
        "media",
        "run_budget"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "seeds": {
                "properties": {
                  "kind": {
                    "const": "works"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "discovery": {
                "properties": {
                  "max_depth": {
                    "const": 0
                  },
                  "entrypoints": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "media": {
                "properties": {
                  "image_policy": {
                    "properties": {
                      "profile": {
                        "const": "original"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "media": {
                "properties": {
                  "retain_original": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "media": {
                "properties": {
                  "image_policy": {
                    "properties": {
                      "profile": {
                        "const": "metadata_only"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "media": {
                "properties": {
                  "retain_original": {
                    "const": false
                  },
                  "ugoira": {
                    "const": "metadata_only"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "CreateJob": {
      "type": "object",
      "properties": {
        "request_key": {
          "$ref": "#/definitions/Id"
        },
        "definition": {
          "$ref": "#/definitions/JobDefinition"
        }
      },
      "required": ["request_key", "definition"],
      "additionalProperties": false
    },
    "CreateLake": {
      "type": "object",
      "properties": {
        "request_key": {
          "$ref": "#/definitions/Id"
        },
        "site": {
          "const": "pixiv"
        },
        "media_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "index_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        }
      },
      "required": ["request_key", "site", "media_root", "index_root"],
      "additionalProperties": false
    },
    "CollectionLake": {
      "type": "object",
      "properties": {
        "library_id": {
          "$ref": "#/definitions/Id"
        },
        "site": {
          "const": "pixiv"
        },
        "media_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "index_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "archive_format": {
          "const": 2
        },
        "online_format": {
          "const": 3
        },
        "collector": {
          "const": "pixiv_web_v1"
        },
        "state": {
          "type": "string",
          "enum": ["ready", "needs_review"]
        }
      },
      "required": [
        "library_id",
        "site",
        "media_root",
        "index_root",
        "archive_format",
        "online_format",
        "collector",
        "state"
      ],
      "additionalProperties": false
    },
    "Cookie": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "domain": {
          "type": "string",
          "enum": [
            ".pixiv.net",
            "pixiv.net",
            "www.pixiv.net",
            "accounts.pixiv.net"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "secure": {
          "const": true
        },
        "http_only": {
          "type": "boolean"
        },
        "expires_unix": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "value",
        "domain",
        "path",
        "secure",
        "http_only",
        "expires_unix"
      ],
      "additionalProperties": false
    },
    "SaveAccount": {
      "type": "object",
      "properties": {
        "request_key": {
          "$ref": "#/definitions/Id"
        },
        "expected_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "account_id": {
          "$ref": "#/definitions/Id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cookies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Cookie"
          },
          "minItems": 1,
          "maxItems": 128
        }
      },
      "required": [
        "request_key",
        "expected_revision",
        "account_id",
        "label",
        "cookies"
      ],
      "additionalProperties": false
    },
    "Account": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "site": {
          "const": "pixiv"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": ["unverified", "valid", "expired", "challenge", "cleared"]
        },
        "credential_set": {
          "type": "boolean"
        },
        "bound_user_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_probe_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/Utc"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "site",
        "label",
        "revision",
        "state",
        "credential_set",
        "bound_user_id",
        "last_probe_at"
      ],
      "additionalProperties": false
    },
    "JobState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "pausing",
        "paused",
        "waiting_credentials",
        "waiting_retry",
        "waiting_resources",
        "waiting_budget",
        "publishing",
        "cancelling",
        "cancelled",
        "completed",
        "completed_with_gaps",
        "needs_review"
      ]
    },
    "JobAction": {
      "type": "object",
      "properties": {
        "request_key": {
          "$ref": "#/definitions/Id"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "pause",
            "resume",
            "retry_failed",
            "cancel",
            "replay_publication"
          ]
        },
        "task_ids": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Hash"
          },
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true
        }
      },
      "required": ["request_key", "expected_revision", "action"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "retry_failed"
              }
            }
          },
          "then": {},
          "else": {
            "not": {
              "required": ["task_ids"]
            }
          }
        }
      ]
    },
    "Progress": {
      "type": "object",
      "properties": {
        "authors": {
          "type": "object",
          "properties": {
            "discovered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "admitted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "scanned": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["discovered", "admitted", "scanned"],
          "additionalProperties": false
        },
        "works": {
          "type": "object",
          "properties": {
            "planned": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "details": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "gaps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["planned", "details", "gaps"],
          "additionalProperties": false
        },
        "media": {
          "type": "object",
          "properties": {
            "planned": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "downloaded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "historical_reused": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "http_validated": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "archived": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "published": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "gaps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "planned",
            "downloaded",
            "historical_reused",
            "http_validated",
            "archived",
            "published",
            "gaps"
          ],
          "additionalProperties": false
        },
        "objects": {
          "type": "object",
          "properties": {
            "stored": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "browsable_images": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["stored", "browsable_images"],
          "additionalProperties": false
        },
        "download_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "publication": {
          "type": "object",
          "properties": {
            "archive_seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "served_seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pending_batches": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["archive_seq", "served_seq", "pending_batches"],
          "additionalProperties": false
        },
        "closure": {
          "type": "object",
          "properties": {
            "discovery_exhausted": {
              "type": "boolean"
            },
            "directories_complete": {
              "type": "boolean"
            },
            "manifests_complete": {
              "type": "boolean"
            },
            "visibility_verified": {
              "type": "boolean"
            }
          },
          "required": [
            "discovery_exhausted",
            "directories_complete",
            "manifests_complete",
            "visibility_verified"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "authors",
        "works",
        "media",
        "objects",
        "download_bytes",
        "publication",
        "closure"
      ],
      "additionalProperties": false
    },
    "Job": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "library_id": {
          "$ref": "#/definitions/Id"
        },
        "account_id": {
          "$ref": "#/definitions/Id"
        },
        "definition": {
          "$ref": "#/definitions/JobDefinition"
        },
        "state": {
          "$ref": "#/definitions/JobState"
        },
        "desired_state": {
          "type": "string",
          "enum": ["run", "pause", "cancel"]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "execution_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "execution_active": {
          "type": "boolean"
        },
        "wait_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "progress": {
          "$ref": "#/definitions/Progress"
        },
        "created_at": {
          "$ref": "#/definitions/Utc"
        },
        "updated_at": {
          "$ref": "#/definitions/Utc"
        }
      },
      "required": [
        "id",
        "library_id",
        "account_id",
        "definition",
        "state",
        "desired_state",
        "revision",
        "execution_epoch",
        "execution_active",
        "wait_reason",
        "progress",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "JobResult": {
      "type": "object",
      "properties": {
        "job": {
          "$ref": "#/definitions/Job"
        },
        "request_key": {
          "$ref": "#/definitions/Id"
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": ["job", "request_key", "replayed"],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Hash"
        },
        "job_id": {
          "$ref": "#/definitions/Id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "author_profile",
            "author_directory",
            "work_detail",
            "media_manifest",
            "relationship_page",
            "media_download",
            "media_encode",
            "media_poster"
          ]
        },
        "subject_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
