{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dataset Studio",
  "version": "0.9.1",
  "identifier": "com.xuness.datasetstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Dataset Studio",
        "width": 1540,
        "height": 980,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#202020",
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "externalBin": ["binaries/studio-engine-sidecar"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
